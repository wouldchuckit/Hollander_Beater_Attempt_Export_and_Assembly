            {
              "atomType": "Readme",
              "x": 0.5,
              "y": 0.9,
              "uniqueID": "id-5188",
              "name": "README",
              "ioValues": [
                {
                  "name": "value",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ],
              "readMeText": "There should be teeth set into the bottom or curve of the bottom section.  All of the hollander wisdom suggets they should be at an angle across the bottom so I will perhaps cut those later by hand. ",
              "global": true
            },
            {
              "atomType": "Readme",
              "x": 0.2,
              "y": 0.8,
              "uniqueID": "id-5190",
              "name": "README",
              "ioValues": [
                {
                  "name": "value",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ],
              "readMeText": "I intend to drill holes through the rotor and teeth when it is all assembled for stainless steel screws to go through the teeth to hold them in. Currently thinking diagonal but could do vertically through the tooth with a countersink",
              "global": true
            },
